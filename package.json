{
  "name": "university-management-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/src/server.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "prisma generate && vitest run",
    "test:run": "npm run test",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:generate": "npm run prisma:generate",
    "db:validate": "npm run prisma:validate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "2.8.6",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
